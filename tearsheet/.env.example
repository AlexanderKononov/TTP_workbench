# Copy to .env (gitignored) and fill in with your Supabase project's values:
# Project Settings -> API in the Supabase dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY is a trusted, full-access key - it must never be
# committed or exposed to a browser. It's safe here only because this app's
# Supabase calls all happen server-side in the Streamlit process.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
