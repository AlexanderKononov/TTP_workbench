# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community
# Cloud's Settings -> Secrets when deploying. Same values as .env.example;
# src/database.py checks st.secrets first, then falls back to .env/os.environ.
[supabase]
url = "https://your-project-ref.supabase.co"
service_role_key = "your-service-role-key"
