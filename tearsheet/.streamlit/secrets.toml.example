# Template for Streamlit secrets (used on Streamlit Community Cloud, and
# optionally for local dev instead of auth_config.yaml).
#
# For Streamlit Cloud: do NOT create a real secrets.toml file in git. Instead,
# paste this content (with real values) into the app's Settings > Secrets
# text box in the Streamlit Cloud dashboard.
#
# For local dev: copy this file to .streamlit/secrets.toml (gitignored) if
# you'd rather use secrets than auth_config.yaml.
#
# Generate each password hash with:
#   python scripts/hash_password.py "your-new-password"

[auth.credentials.usernames.alexander]
name = "Alexander"
email = "alexander@example.com"
password = "$2b$12$y9stMbGkOF.RJyHQm8Z4oeVxmrQBu9QJ6VHAJNS8k7w/gzZC.SX/q"

[auth.credentials.usernames.friend]
name = "Friend"
email = "friend@example.com"
password = "$2b$12$y9stMbGkOF.RJyHQm8Z4oeVxmrQBu9QJ6VHAJNS8k7w/gzZC.SX/q"

[auth.cookie]
name = "tearsheet_auth"
key = "change_this_to_a_random_secret"
expiry_days = 30
